{
  "schemaVersion": 1,
  "id": "aibuilder",
  "version": "${version}",
  "name": "AIbuilder",
  "description": "AI驱动的Minecraft建筑生成模组，支持多种AI模型提供商生成Litematic投影文件",
  "authors": ["Kaoyu666"],
  "contact": {},
  "license": "LGPL-3.0",
  "icon": "assets/aibuilder/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "cn.kaoyu666.aibuilder.client.AibuilderDataGenerator"
    ],
    "client": [
      "cn.kaoyu666.aibuilder.client.AibuilderClient"
    ],
    "main": [
      "cn.kaoyu666.aibuilder.Aibuilder"
    ],
    "modmenu": [
      "cn.kaoyu666.aibuilder.client.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "aibuilder.mixins.json",
    {
      "config": "aibuilder.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "litematica": ">=0.18.0",
    "malilib": ">=0.19.0",
    "modmenu": ">=10.0.0"
  }
}
