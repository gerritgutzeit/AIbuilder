{
  "schemaVersion": 1,
  "id": "aibuilder",
  "version": "${version}",
  "name": "AIbuilder",
  "description": "AI-driven Minecraft building generator mod that creates Litematic projection files using various AI model providers",
  "authors": ["Kaoyu666"],
  "contact": {},
  "license": "LGPL-3.0",
  "icon": "assets/aibuilder/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cn.kaoyu666.aibuilder.client.AibuilderClient"
    ],
    "main": [
      "cn.kaoyu666.aibuilder.Aibuilder"
    ],
    "modmenu": [
      "cn.kaoyu666.aibuilder.client.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "aibuilder.mixins.json",
    {
      "config": "aibuilder.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "litematica": ">=0.0.0-dev.20210917.192300",
    "malilib": ">=0.10.0-dev.21",
    "modmenu": ">=1.16.23"
  }
}
